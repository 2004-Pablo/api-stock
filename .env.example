# Puerto del servidor HTTP
PORT=4000

# Entorno: development | production | test
NODE_ENV=development

# Secreto para firmar los JWT. Cambiar por un valor largo y aleatorio en produccion.
JWT_SECRET=cambiar-este-secreto-en-produccion
JWT_EXPIRES_IN=1d

# Ruta del archivo SQLite (relativa a la raiz del backend)
DB_STORAGE=data/inventario.sqlite

# Origenes permitidos para CORS, separados por coma
CORS_ORIGIN=http://localhost:5173

# Sincroniza el esquema automaticamente al arrancar (solo desarrollo)
DB_SYNC=true
